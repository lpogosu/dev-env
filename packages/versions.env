# shellcheck shell=sh
# shellcheck disable=SC2034  # every name here is read by the script that sources this file
#
# Artefacts fetched from upstream releases instead of from a distribution.
#
# Neovim: Debian 12 ships 0.7, which cannot load this configuration at all, so
# the release tarball is used on every Linux. Upstream publishes no checksum
# file for the release, so the values below were computed from the downloaded
# artefacts and pinned here. That is trust on first use, not a signature chain:
# it pins the bytes against later mutation of the release asset, and nothing
# more. Updating Neovim means changing four lines and rerunning the container
# tests.
NVIM_VERSION=v0.12.5
NVIM_SHA256_LINUX_X86_64=bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875
NVIM_SHA256_LINUX_ARM64=1aa5ca085249580ae0f91eb14f27ec0919773ff2d99a163d03f3d6c21ac29725

# StyLua: used only by scripts/lint-lua.sh, never installed on a workstation by
# bootstrap.sh.
STYLUA_VERSION=v2.5.2
STYLUA_SHA256_LINUX_X86_64=bcb0d855e91f102f28a370e850f8566b3b44b79e6274d806ea5246837c0fd5ab
STYLUA_SHA256_LINUX_AARCH64=0ef2ebf0b7e5a652b65c4cb96c6d9ffb3981a98547de3c764465bbf54a8d761a
