root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.lua]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

# home/.config/git/config: tabs, because that is what `git config --global`
# itself writes, and a mixed file is a diff on the next machine-local edit.
[config]
indent_style = tab
