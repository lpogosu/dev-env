# OpenSSH client defaults.
#
# ssh_config is first-match-wins for every keyword, which is the opposite of
# git's last-value-wins. That is why the include is at the top: a host entry in
# ~/.ssh/config.d/ can override anything below, and nothing below can override
# it. config.d/ is created by bootstrap.sh and never tracked, so real hostnames,
# jump hosts and key paths stay off GitHub.
Include ~/.ssh/config.d/*.conf

Host *
    # Multiplex: the second connection to a host reuses the first one's TCP
    # session and skips the handshake entirely. ControlPersist keeps the master
    # alive briefly after the last session, which is what makes a loop of
    # `ssh host command` fast instead of one full handshake per iteration.
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 60

    # %C is a hash of user/host/port, so the socket path stays short. The
    # obvious %r@%h:%p overflows the 104-byte sockaddr_un limit on hosts with
    # long names, and the failure looks like a hang.

    # Keep NAT and firewall state alive, and notice a dead peer instead of
    # blocking forever on a session that will never answer.
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive no

    # Offer only the key that matches this host, rather than every key in the
    # agent in turn. With more than five keys loaded, the default behaviour
    # exhausts MaxAuthTries on the server and the login fails with a message
    # that says nothing about the real cause.
    IdentitiesOnly yes

    # Never let a remote host's agent request reach the local agent, and never
    # forward X11, unless a host entry in config.d/ asks for it explicitly.
    ForwardAgent no
    ForwardX11 no

    # Hash hostnames in known_hosts: a stolen laptop's known_hosts should not be
    # a map of the infrastructure.
    HashKnownHosts yes

    # Ask before accepting an unknown host key, and refuse outright if a key
    # for that host is already known and differs.
    StrictHostKeyChecking ask

    AddKeysToAgent yes
    Compression no
